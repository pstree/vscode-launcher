{
  "name": "vscode-launcher",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Multi Launch",
      "properties": {
        "multiLauncher.portPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional regex patterns to detect application ports from debug output (case-insensitive)."
        }
      }
    },
    "views": {
      "debug": [
        {
          "id": "multiLauncherView",
          "name": "%view.multiLauncherView.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "multiLauncher.configureLaunch",
        "title": "%cmd.configureLaunch%",
        "category": "Multi Launch",
        "icon": "$(gear)"
      },
      {
        "command": "multiLauncher.launchSelected",
        "title": "%cmd.launchSelected%",
        "category": "Multi Launch",
        "icon": "$(play)"
      },
      {
        "command": "multiLauncher.launchOne",
        "title": "%cmd.launchOne%",
        "icon": "$(play)"
      },
      {
        "command": "multiLauncher.stopOne",
        "title": "%cmd.stopOne%",
        "icon": "$(stop)"
      },
      {
        "command": "multiLauncher.stopAllRunning",
        "title": "%cmd.stopAllRunning%",
        "icon": "$(stop)"
      },
      {
        "command": "multiLauncher.launchAllIdle",
        "title": "%cmd.launchAllIdle%",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiLauncher.configureLaunch",
          "when": "view == multiLauncherView",
          "group": "navigation@0"
        },
        {
          "command": "multiLauncher.launchSelected",
          "when": "view == multiLauncherView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "multiLauncher.launchOne",
          "when": "view == multiLauncherView && viewItem == idle",
          "group": "inline"
        },
        {
          "command": "multiLauncher.stopOne",
          "when": "view == multiLauncherView && viewItem == running",
          "group": "inline"
        },
        {
          "command": "multiLauncher.launchAllIdle",
          "when": "view == multiLauncherView && viewItem == group-idle",
          "group": "inline"
        },
        {
          "command": "multiLauncher.launchAllIdle",
          "when": "view == multiLauncherView && viewItem == group-idle",
          "group": "2_launch"
        },
        {
          "command": "multiLauncher.stopAllRunning",
          "when": "view == multiLauncherView && viewItem == group-running",
          "group": "inline"
        },
        {
          "command": "multiLauncher.stopAllRunning",
          "when": "view == multiLauncherView && viewItem == group-running",
          "group": "2_stop"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.4.0"
  }
}
